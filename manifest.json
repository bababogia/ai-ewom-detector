{
  "manifest_version": 3,
  "name": "eWOM AI Detector",
  "version": "1.0",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
 "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*", 
        "*://*.amazon.de/*", 
        "*://*.amazon.co.uk/*",
        "*://*.amazon.it/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.es/*"
      ],
      "js": ["content.js"]
    }
  ]
}